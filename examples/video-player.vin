# Video Streaming App
# Netflix-inspired layout with cards, panels, avatars, and modals

page "Watch" 900x680

# -- Nav Bar --

panel "nav" 0,0 900x48
  variant: dark

heading "StreamBox" 16,12
  level: 2

tabs "nav-tabs" 160,7 400x34
  items: "Home" | "Movies" | "Series" | "My List"
  active: 0

textfield "search" 640,9 180x30
  placeholder: "Search..."

avatar "U" 836,4 40x40
  variant: purple

# -- Hero / Featured --

panel "hero" 0,48 900x240
  variant: dark

image "hero-poster" 30,68 180x200
  alt: "Featured Film"

heading "The Last Frontier" 230,80
  level: 1

label "2026 — Sci-Fi — 2h 18m" 230,112
  font-size: small

badge "98% Match" 230,136 80x22
  variant: success

badge "PG-13" 318,136 52x22

label "When humanity's final colony ship discovers a habitable" 230,172
label "world already claimed by another civilization, one crew" 230,192
label "member must bridge two species to prevent extinction." 230,212

button "Play" 230,240 100x36
  variant: primary

button "+ My List" 340,240 100x36

button "Details" 450,240 80x36


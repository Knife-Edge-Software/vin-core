# Email Inbox
# Gmail-inspired email client

page "Inbox" 960x620

# -- Top Bar --

frame "topbar" 0,0 960x48

heading "Mail" 16,16
  level: 2

textfield "search" 240,9 440x30
  placeholder: "Search mail..."

icon "bell" 780,12 24x24

icon "gear" 816,12 24x24

image "avatar" 856,8 32x32
  alt: "Me"

# -- Sidebar --

frame "sidebar" 0,48 200x572

button "Compose" 16,64 168x36
  variant: primary

list "folders" 8,116 184x216
  items: "Inbox (12)" | "Starred" | "Snoozed" | "Sent" | "Drafts (3)" | "Spam" | "Trash" | "Important" | "All Mail"
  selected: 0

separator "s1" 16,344 168x2

label "Labels" 16,360
  font-size: small
  bold: true

list "labels" 8,380 184x96
  items: "Work" | "Personal" | "Receipts" | "Newsletters"

separator "s2" 16,488 168x2

label "45% of 15 GB used" 16,504
  font-size: small

progress "storage" 16,524 168x6
  value: 45

# -- Toolbar --

frame "toolbar" 200,48 760x40

checkbox "select-all" 216,58

button "Archive" 250,55 70x26

button "Delete" 326,55 60x26
  variant: danger

button "Move" 392,55 54x26

button "Label" 452,55 54x26

label "1–50 of 1,284" 830,62
  font-size: small

button "<" 910,55 20x26

button ">" 934,55 20x26


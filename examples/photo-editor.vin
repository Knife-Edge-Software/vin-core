# Photo Editor
# Image editing app with panels, sliders, tabs, and splitters

page "Photo Editor" 960x640

# -- Top Bar --

panel "topbar" 0,0 960x44
  variant: dark

heading "PhotoEdit" 16,10
  level: 2

breadcrumb "path" 130,16
  items: "Projects" | "Vacation 2026" | "sunset.jpg"

button "Export" 780,8 80x28
  variant: primary

button "Share" 868,8 76x28

# -- Tools Sidebar --

panel "tools" 0,44 52x596
  variant: dark

icon "mouse-pointer" 14,60 24x24

icon "crop" 14,96 24x24

icon "paintbrush" 14,132 24x24

icon "eraser" 14,168 24x24

icon "type" 14,204 24x24

icon "shapes" 14,240 24x24

icon "stamp" 14,276 24x24

icon "bandage" 14,312 24x24

# -- Canvas Area --

panel "canvas-bg" 52,44 660x596

image "canvas" 102,72 560x420
  alt: "sunset.jpg"

# -- Splitter --

splitter "main-split" 712,44 8x596
  direction: vertical

# -- Properties Panel --

panel "props" 720,44 240x596

tabs "prop-tabs" 720,44 240x34

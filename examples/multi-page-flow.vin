  placeholder: "you@example.com"

label "Password" 40,230
textfield "password" 40,250 320x32
  mask: true
  placeholder: "Choose a password"

button "Create Account" 40,310 320x40
  variant: primary

button "Back" 40,370 150x36

page "All Set" 400x500

heading "You're All Set!" 40,80
  level: 1

icon "check" 175,160 50x50
  name: "checkmark"

label "Your account has been created." 40,240
  align: center

label "Start exploring the dashboard." 40,270
  align: center

button "Go to Dashboard" 40,340 320x40
  variant: primary

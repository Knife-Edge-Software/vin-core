vin-format: 1

page "Welcome" 400x500

heading "Welcome to Acme" 40,40
  level: 1

label "Get started in just a few steps." 40,90
  font-size: large

image "hero" 40,140 320x180
  alt: "Welcome illustration"

button "Get Started" 40,350 320x40
  variant: primary

link "Already have an account? Sign in" 40,410

page "Create Account" 400x500

heading "Create Account" 40,40
  level: 2

label "Name" 40,90
